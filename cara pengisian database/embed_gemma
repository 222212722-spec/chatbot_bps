import json
import torch
from sentence_transformers import SentenceTransformer
from google.colab import drive
import os

# --- 1. Mount Drive & Config ---
if not os.path.exists('/content/drive'):
    drive.mount('/content/drive')

device = "cuda" if torch.cuda.is_available() else "cpu"
model_id = "google/embeddinggemma-300m"

# Path File (Gunakan file output dari Bagian 1)
input_filepath = "/content/drive/MyDrive/qwe/alltables_ready.json"
output_filepath = "/content/drive/MyDrive/qwe/alltables_embedded_gemma.json"

# --- 2. Load Model ---
print(f"Loading model: {model_id} on {device}...")
# trust_remote_code=True sering diperlukan untuk model baru
model = SentenceTransformer(model_id, device=device, trust_remote_code=True)

# --- 3. Load JSON Data ---
try:
    with open(input_filepath, "r", encoding="utf-8") as f:
        data = json.load(f)
    print(f"Data loaded: {len(data)} items.")
except Exception as e:
    print(f"Error loading JSON: {e}")
    data = []

# --- 4. Prepare GEMMA SPECIFIC PROMPTS ---
# Ini adalah langkah paling krusial. Kita tidak embed 'page_content' mentah-mentah.
# Kita buat list string yang diformat sesuai instruksi resmi: title: {x} | text: {y}

inputs_to_embed = []
valid_indices = [] # Menyimpan index data yang valid

print("Formatting inputs for Embedding Gemma...")

for i, item in enumerate(data):
    # Pastikan data punya title dan subcat
    if item.get('title'):
        t_subcat = item.get('subcat', 'General')
        t_title = item.get('title', '')

        # --- RUMUS RESMI EMBEDDING GEMMA (Document Side) ---
        # Format: title: {title | "none"} | text: {content}
        # Kita manfaatkan Subcat sebagai 'Title' dokumen, dan Judul Tabel sebagai 'Text'
        formatted_input = f"title: {t_subcat} | text: {t_title}"

        inputs_to_embed.append(formatted_input)
        valid_indices.append(i)

# Cek sampel input
if inputs_to_embed:
    print(f"\nContoh input ke model (Index 0):\n{inputs_to_embed[0]}")
    print(f"Total data siap embed: {len(inputs_to_embed)}")

# --- 5. Batch Embedding ---
if inputs_to_embed:
    try:
        print(f"\nStarting embedding process (Batch size: 32)...")

        embeddings = model.encode(
            inputs_to_embed,
            batch_size=32,
            show_progress_bar=True,
            convert_to_tensor=False,
            normalize_embeddings=True # Penting untuk Cosine Similarity
        )

        # --- 6. Masukkan Embedding ke Data Asli ---
        # Kita simpan embedding vectornya ke dalam JSON object asli
        # (yang page_content-nya sudah diperbaiki di step 1 untuk dibaca manusia)
        for idx, emb_vector in zip(valid_indices, embeddings):
            data[idx]['embedding'] = emb_vector.tolist()

        # Simpan
        with open(output_filepath, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=4)

        print(f"\nSUCCESS! Embeddings saved to: {output_filepath}")

    except Exception as e:
        print(f"Error during embedding: {e}")
else:
    print("No valid data to embed.")
